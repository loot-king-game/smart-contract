{
  "name": "loot-king-smart-contract",
  "private": true,
  "license": "ISC",
  "scripts": {
    "build": "anchor build --no-idl",
    "build:verifiable": "bash scripts/build.sh",
    "test": "anchor build --no-idl && RUST_LOG=error ts-mocha -p ./tsconfig.json -t 1000000 \"tests/**/*.ts\"",
    "idl:build": "RUSTUP_TOOLCHAIN=1.89.0 anchor idl build -o idl/loot_king.json -t idl/loot_king.ts",
    "idl:check": "tsx scripts/idl-check.ts",
    "status": "tsx scripts/status.ts",
    "fund-vault": "tsx scripts/fund-vault.ts",
    "program:deploy": "bash scripts/deploy.sh",
    "program:upgrade": "bash scripts/upgrade.sh",
    "authority:transfer": "bash scripts/transfer-authority.sh",
    "game:setup": "tsx scripts/game-setup.ts",
    "game-authority:accept": "tsx scripts/accept-game-authority.ts",
    "send-tx": "tsx scripts/send-tx.ts",
    "verify": "bash scripts/verify.sh",
    "metadata:security": "bash scripts/security-metadata.sh",
    "typecheck": "tsc --noEmit -p tsconfig.scripts.json",
    "lint": "prettier \"{scripts,tests}/**/*.ts\" --check",
    "lint:fix": "prettier \"{scripts,tests}/**/*.ts\" -w"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@ledgerhq/hw-app-solana": "^7.10.2",
    "@ledgerhq/hw-transport-node-hid": "^6.33.2"
  },
  "devDependencies": {
    "@solana/web3.js": "^1.98.4",
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "@types/node": "^26.6.2",
    "anchor-bankrun": "^0.5.0",
    "chai": "^4.3.4",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "solana-bankrun": "^0.4.0",
    "ts-mocha": "^10.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-hid",
      "usb"
    ]
  }
}
